# Copy to .env (gitignored) and fill in. Write KEY=value with no spaces around "=": Docker's --env-file rejects them.
# The runner hands this file to the container; the agent's shell never sees the values.

# Required for real runs (provider: openrouter in every deploysim config).
OPENROUTER_API_KEY=

# Optional: Fireworks provider (provider: fireworks or fireworks_completions).
FIREWORKS_API_KEY=

# Optional: Docent upload. deploysim/scripts/upload_ds.py keeps its own collection id in results/deploysim/;
# DOCENT_COLLECTION_ID is used by scripts/upload_to_docent.py for the original 2x2.
DOCENT_API_KEY=
DOCENT_COLLECTION_ID=
